{
  "name": "meridian-mobile-preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mobile web preview for Meridian Money rehearsal companion — phone-first browser interface.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run build && npm test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@atlaskit/button": "^25.3.5",
    "@atlaskit/css-reset": "^8.4.4",
    "@atlaskit/lozenge": "^15.4.3",
    "@atlaskit/platform-feature-flags": "^2.2.0",
    "@atlaskit/section-message": "^10.2.4",
    "@atlaskit/textfield": "^10.2.4",
    "@atlaskit/tokens": "18.2.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.6",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.19.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
